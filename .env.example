# Lidas por src/main/resources/application.properties (backend Spring).
# O secret precisa ter mais de 32 bytes. Fora de desenvolvimento, troque por um valor próprio.
JWT_SECRET=troque-esta-chave-local-por-uma-chave-com-mais-de-32-bytes
JWT_EXPIRATION_MS=900000

# Lidas por compose.yaml (container de banco para desenvolvimento).
# Atenção: o backend hoje sobe com H2 em memória, então este Postgres só entra em uso
# se você apontar spring.datasource.url para ele.
POSTGRES_DB=studdy
POSTGRES_USER=studdy
POSTGRES_PASSWORD=studdy_dev
POSTGRES_PORT=5432
