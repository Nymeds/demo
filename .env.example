# Lidas por backend/src/main/resources/application.properties (backend Spring).
# DB_PASSWORD é obrigatório; sem ele a conexão com PostgreSQL falha.
DB_URL=jdbc:postgresql://localhost:5432/academic_organizer
DB_USERNAME=academic_organizer
# Obrigatório. Escolha uma senha para o banco (ex.: openssl rand -base64 18).
DB_PASSWORD=
# Obrigatório, mínimo de 32 bytes. Vazio, o "npm run init" gera um valor aleatório e grava aqui.
# Fora do init, gere um valor próprio:
#   Git Bash/Linux/macOS: openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=
JWT_EXPIRATION_MS=900000
# true em produção HTTPS; false permite o localhost HTTP para desenvolvimento.
AUTH_COOKIE_SECURE=false
# Opcionais: DDL_AUTO=update (plano: validate), DB_POOL_SIZE=10, SESSION_PURGE_CRON=0 30 3 * * *
# FORWARD_HEADERS_STRATEGY: none por padrão; o init usa native confiando só no proxy local do Vite.

# Recuperação de senha (serviço Nodemailer em mailer/). "node scripts/setup-recovery.mjs" preenche
# MAILER_API_SECRET aqui e em mailer/.env com a mesma chave (mínimo 32 bytes aleatórios).
MAILER_URL=http://127.0.0.1:3001
# true: a API inicia o mailer sozinha ao subir (precisa de mailer/.env e "npm ci" em mailer/).
MAILER_AUTO_START=true
# Opcionais: MAILER_DIRECTORY=../mailer (relativo a backend/, de onde a API roda) e
# NODE_EXECUTABLE=node (ou caminho absoluto).
MAILER_API_SECRET=
# Chave independente e aleatória para proteger os hashes de códigos (mínimo 32 bytes).
# Vazia, o "npm run init" gera um valor aleatório e grava aqui (como o JWT_SECRET).
RECOVERY_HASH_SECRET=

# Também lidas por compose.yaml (container de banco): DB_USERNAME, DB_PASSWORD, DB_NAME e DB_PORT.
# Mantenha DB_URL coerente com DB_NAME e DB_PORT.
DB_NAME=academic_organizer
DB_PORT=5432

# Opcionais do "init" (npm run init): use se as portas padrão estiverem ocupadas.
# SERVER_PORT=8080
# FRONTEND_PORT=5173
