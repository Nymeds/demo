# Lidas por backend/src/main/resources/application.properties (backend Spring).
# DB_PASSWORD é obrigatório; sem ele a conexão com PostgreSQL falha.
DB_URL=jdbc:postgresql://localhost:5432/academic_organizer
DB_USERNAME=academic_organizer
# Obrigatório. Escolha uma senha para o banco (ex.: openssl rand -base64 18).
DB_PASSWORD=
# Obrigatório, mínimo de 32 bytes. Vazio, o "npm run init" gera um valor aleatório e grava aqui.
# Fora do init, gere um valor próprio:
#   Git Bash/Linux/macOS: openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=
JWT_EXPIRATION_MS=900000

# Também lidas por compose.yaml (container de banco): DB_USERNAME, DB_PASSWORD, DB_NAME e DB_PORT.
# Mantenha DB_URL coerente com DB_NAME e DB_PORT.
DB_NAME=academic_organizer
DB_PORT=5432

# Opcionais do "init" (npm run init): use se as portas padrão estiverem ocupadas.
# SERVER_PORT=8080
# FRONTEND_PORT=5173
