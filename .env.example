# Lidas por src/main/resources/application.properties (backend Spring).
# DB_PASSWORD é obrigatório; sem ele a conexão com PostgreSQL falha.
DB_URL=jdbc:postgresql://localhost:5432/academic_organizer
DB_USERNAME=academic_organizer
DB_PASSWORD=Senha123
# O secret precisa ter mais de 32 bytes. Fora de desenvolvimento, troque por um valor próprio.
JWT_SECRET=f9XGyIuCKcpe0aozmBSqs7L4Zk8UiFRvhYNt1dlVDAOE562TjnHxbMgrWwPQJ3
JWT_EXPIRATION_MS=900000

# Também lidas por compose.yaml (container de banco): DB_USERNAME, DB_PASSWORD, DB_NAME e DB_PORT.
# Mantenha DB_URL coerente com DB_NAME e DB_PORT.
DB_NAME=academic_organizer
DB_PORT=5432

# Opcionais do "init" (npm run init): use se as portas padrão estiverem ocupadas.
# SERVER_PORT=8080
# FRONTEND_PORT=5173
