# Copie para mailer/.env. Não use a senha normal da sua conta Google.
SMTP_HOST=smtp.gmail.com
# auto testa 465 (TLS) e depois 587 (STARTTLS). Pode fixar 465 ou 587.
SMTP_PORT=auto
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=senha-de-app-do-google
MAIL_FROM_NAME=AcadOrganize
# Gere uma chave aleatória de 32 bytes ou mais; use a mesma chave no backend.
MAILER_API_SECRET=
MAILER_HOST=127.0.0.1
MAILER_PORT=3001
